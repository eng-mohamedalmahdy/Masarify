CREATE TABLE IF NOT EXISTS sync_queue (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    entity_type TEXT NOT NULL,
    operation TEXT NOT NULL,
    payload TEXT NOT NULL,
    local_id INTEGER,
    remote_id INTEGER,
    created_at INTEGER NOT NULL,
    retry_count INTEGER NOT NULL DEFAULT 0,
    status TEXT NOT NULL DEFAULT 'PENDING'
);

insertEntry:
INSERT INTO sync_queue (entity_type, operation, payload, local_id, remote_id, created_at)
VALUES (:entityType, :operation, :payload, :localId, :remoteId, :createdAt);

getPendingEntries:
SELECT * FROM sync_queue WHERE status = 'PENDING' ORDER BY created_at ASC;

markSent:
UPDATE sync_queue SET status = 'SENT', remote_id = :remoteId WHERE id = :id;

incrementRetry:
UPDATE sync_queue SET retry_count = retry_count + 1 WHERE id = :id;

markFailed:
UPDATE sync_queue SET status = 'FAILED' WHERE id = :id;

deleteById:
DELETE FROM sync_queue WHERE id = :id;

getPendingCount:
SELECT COUNT(*) FROM sync_queue WHERE status = 'PENDING';
