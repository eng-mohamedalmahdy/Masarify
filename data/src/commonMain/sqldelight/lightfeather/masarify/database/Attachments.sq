CREATE TABLE  IF NOT EXISTS  attachments (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT ,
    entity_type TEXT NOT NULL,
    entity_id INTEGER,
    data BLOB NOT NULL,
    mime_type TEXT NOT NULL
);

insertAttachment:
INSERT INTO attachments (entity_type, entity_id, name, data, mime_type)
VALUES (:entity_type, :entity_id, :name, :data, :mime_type);

updateAttachment:
UPDATE attachments
SET entity_type = :entity_type,
    entity_id = :entity_id,
    name = :name,
    data = :data,
    mime_type = :mime_type
WHERE id = :id;



getAllAttachments:
SELECT * FROM v_attachments;

getAttachmentById:
SELECT * FROM v_attachments
WHERE attachmentId = :id;

getAttachmentsByTransactionId:
SELECT * FROM v_attachments
WHERE entityType = 'transaction' AND entityId = :transaction_id AND entityId NOT NULL ;

getAttachmentsByEntity:
SELECT * FROM v_attachments
WHERE entityType = :entity_type AND entityId = :entity_id;


deleteAttachmentById:
DELETE FROM attachments
WHERE id = :id;

deleteAttachmentsByTransactionId:
DELETE FROM attachments
WHERE entity_type = 'transaction' AND entity_id = :transaction_id;

deleteAttachmentsByEntity:
DELETE FROM attachments
WHERE entity_type = :entity_type AND entity_id = :entity_id;



countAttachmentsByTransactionId:
SELECT COUNT(*)
FROM attachments
WHERE entity_type = 'transaction' AND entity_id = :transaction_id;

countAttachmentsByEntity:
SELECT COUNT(*)
FROM attachments
WHERE entity_type = :entity_type AND entity_id = :entity_id;

selectLastInsertedAttachmentId:
SELECT last_insert_rowid();
