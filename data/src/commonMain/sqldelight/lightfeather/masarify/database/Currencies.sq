CREATE TABLE currencies(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name  TEXT NOT NULL,
  sign TEXT NOT NULL
);

insertCurrency:
INSERT INTO currencies (name, sign)
VALUES (:name, :sign);

updateCurrency:
UPDATE currencies
SET name = :name,
    sign = :sign
WHERE id = :id;

deleteCurrency:
DELETE FROM currencies
WHERE id = :id;

selectAllCurrencies:
SELECT * FROM v_currencies;

selectCurrencyById:
SELECT * FROM v_currencies
WHERE currencyId = :id;


selectLastInsertedRowId:
SELECT last_insert_rowid();