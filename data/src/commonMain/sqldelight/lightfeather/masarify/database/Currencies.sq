CREATE TABLE  IF NOT EXISTS  currencies(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name  TEXT NOT NULL,
  sign TEXT NOT NULL,
  type TEXT NOT NULL DEFAULT 'TRADITIONAL',
  is_default INTEGER NOT NULL DEFAULT 0,
  resource_key TEXT,
  iso_code TEXT,
  remote_id INTEGER,
  sync_status TEXT NOT NULL DEFAULT 'PENDING'
);

insertCurrency:
INSERT INTO currencies (name, sign, type, is_default, resource_key, iso_code)
VALUES (:name, :sign, :type, :is_default, :resource_key, :iso_code);

updateCurrency:
UPDATE currencies
SET name = :name,
    sign = :sign,
    type = :type,
    is_default = :is_default,
    resource_key = :resource_key,
    iso_code = :iso_code
WHERE id = :id;

deleteCurrency:
DELETE FROM currencies
WHERE id = :id;

selectAllCurrencies:
SELECT * FROM v_currencies;

selectUsedCurrencies:
SELECT DISTINCT vc.*
FROM v_currencies vc
INNER JOIN v_accounts va
    ON va.currencyId = vc.currencyId;

selectCurrencyById:
SELECT * FROM v_currencies
WHERE currencyId = :id;


selectLastInsertedRowId:
SELECT last_insert_rowid();

updateRemoteId:
UPDATE currencies SET remote_id = :remoteId, sync_status = 'SYNCED' WHERE id = :id;

getLocalIdByRemoteId:
SELECT id FROM currencies WHERE remote_id = :remoteId LIMIT 1;

getUnsyncedCurrencyIds:
SELECT id FROM currencies WHERE remote_id IS NULL AND is_default = 0;
