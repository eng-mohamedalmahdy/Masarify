-- Migration 1: Add currency types and bank names support
-- This migration adds new columns to the currencies table and creates the bank_names table

-- Add new columns to currencies table for enhanced currency management
ALTER TABLE currencies ADD COLUMN type TEXT NOT NULL DEFAULT 'TRADITIONAL';
ALTER TABLE currencies ADD COLUMN is_default INTEGER NOT NULL DEFAULT 0;
ALTER TABLE currencies ADD COLUMN resource_key TEXT;

-- Create bank_names table for pre-seeded bank name suggestions
CREATE TABLE IF NOT EXISTS bank_names(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  resource_key TEXT,
  logo_url TEXT,
  is_default INTEGER NOT NULL DEFAULT 0
);
