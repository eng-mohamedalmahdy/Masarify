-- Table
CREATE TABLE IF NOT EXISTS transactions (
    id INTEGER PRIMARY KEY,
    name TEXT,
    description TEXT,
    amount REAL,
    timestamp INTEGER,
    account_id INTEGER NOT NULL,
    type TEXT CHECK(type IN ("INCOME", "EXPENSE", "TRANSFER")),
    attachment_id INTEGER,
    receiver_account_id INTEGER, -- Only for TRANSFER
    fee REAL -- Only for TRANSFER
);

-- Insert Queries
insertTransaction:
INSERT INTO transactions (type, name, description, amount, timestamp, account_id, attachment_id)
VALUES (:type, :name, :description, :amount, :timestamp, :account_id, :attachment);

insertTransfer:
INSERT INTO transactions (type, name, description, amount, timestamp, account_id, attachment_id, receiver_account_id, fee)
VALUES ("TRANSFER", :name, :description, :amount, :timestamp, :account_id, :attachment, :receiver_account_id, :fee);

insertTransactionCategory:
INSERT OR IGNORE INTO transaction_categories(transaction_id, category_id)
VALUES (:transaction_id, :category_id);

-- Update Query (consolidated)
updateTransaction:
UPDATE transactions
SET
    name = :name,
    description = :description,
    amount = :amount,
    timestamp = :timestamp,
    account_id = :account_id,
    attachment_id = :attachment_id,
    type = :type
WHERE id = :id;

-- Delete Queries
deleteTransaction:
DELETE FROM transactions WHERE id = :id;

deleteTransactionCategory:
DELETE FROM transaction_categories WHERE transaction_id = :transaction_id;

-- Queries
getAllTransactionsOfType:
SELECT
    t.id AS id,
    t.name AS transactionName,
    t.description AS transactionDescription,
    t.amount AS amount,
    t.timestamp AS timestamp,
    t.receiver_account_id AS receiverAccountId,
    t.fee AS fee,
    t.attachment_id AS attachmentId,
    a.id AS accountId,
    a.name AS accountName,
    a.description AS accountDescription,
    a.balance AS accountBalance,
    a.color AS accountColor,
    a.logo AS accountLogo,
    c.id AS currencyId,
    c.name AS currencyName,
    c.sign AS currencySign
FROM transactions t
JOIN bank_accounts a ON t.account_id = a.id
JOIN currencies c ON a.currency = c.id
WHERE t.type = :type
ORDER BY t.timestamp DESC;

getCategoriesForTransactionByTransactionId:
SELECT
    c.id,
    c.name,
    c.description,
    c.color,
    c.icon
FROM categories c
JOIN transaction_categories tc ON c.id = tc.category_id
WHERE tc.transaction_id = :transaction_id;

getTransactionOfTypeById:
SELECT
    t.id AS id,
    t.name AS transactionName,
    t.description AS transactionDescription,
    t.amount AS amount,
    t.timestamp AS timestamp,
    t.receiver_account_id AS receiverAccountId,
    t.fee AS fee,
    t.attachment_id AS attachment_id,
    a.id AS accountId,
    a.name AS accountName,
    a.description AS accountDescription,
    a.balance AS accountBalance,
    a.color AS accountColor,
    a.logo AS accountLogo,
    c.id AS currencyId,
    c.name AS currencyName,
    c.sign AS currencySign
FROM transactions t
JOIN bank_accounts a ON t.account_id = a.id
JOIN currencies c ON a.currency = c.id
WHERE t.type = :type
  AND t.id = :id;

-- Aggregates
getMinExpenseOfTransactionType:
SELECT
    t.id AS id,
    t.name AS transactionName,
    t.description AS transactionDescription,
    t.amount AS amount,
    t.timestamp AS timestamp,
    t.receiver_account_id AS receiverAccountId,
    t.fee AS fee,
    t.attachment_id AS attachmentId,
    a.id AS accountId,
    a.name AS accountName,
    a.description AS accountDescription,
    a.balance AS accountBalance,
    a.color AS accountColor,
    a.logo AS accountLogo,
    c.id AS currencyId,
    c.name AS currencyName,
    c.sign AS currencySign
FROM transactions t
JOIN bank_accounts a ON t.account_id = a.id
JOIN currencies c ON a.currency = c.id
WHERE t.type = :type
ORDER BY t.amount ASC
LIMIT 1;

getMaxExpenseOfTransactionType:
SELECT
    t.id AS id,
    t.name AS transactionName,
    t.description AS transactionDescription,
    t.amount AS amount,
    t.timestamp AS timestamp,
    t.receiver_account_id AS receiverAccountId,
    t.fee AS fee,
    t.attachment_id AS attachment_id,
    a.id AS accountId,
    a.name AS accountName,
    a.description AS accountDescription,
    a.balance AS accountBalance,
    a.color AS accountColor,
    a.logo AS accountLogo,
    c.id AS currencyId,
    c.name AS currencyName,
    c.sign AS currencySign
FROM transactions t
JOIN bank_accounts a ON t.account_id = a.id
JOIN currencies c ON a.currency = c.id
WHERE t.type = :type
ORDER BY t.amount DESC
LIMIT 1;

getAvgExpenseOfTransactionType:
SELECT AVG(t.amount) AS averageAmount
FROM transactions t
WHERE t.type = :type;

selectLastInsertedRowId:
SELECT last_insert_rowid();

getTotalTransactionsOfTypeOfCurrency:
SELECT SUM(t.amount) AS total_amount
FROM transactions t
JOIN bank_accounts a ON t.account_id = a.id
WHERE t.type = :type
  AND a.currency = :currencyId;

getTransactionsSumByCategoriesOfType:
SELECT
    c.id AS category_id,
    c.name AS category_name,
    c.description AS category_description,
    c.color AS category_color,
    c.icon AS category_icon,
    SUM(t.amount) AS total_amount
FROM transactions t
JOIN transaction_categories tc ON t.id = tc.transaction_id
JOIN categories c ON tc.category_id = c.id
WHERE t.type = :type
GROUP BY c.id;
