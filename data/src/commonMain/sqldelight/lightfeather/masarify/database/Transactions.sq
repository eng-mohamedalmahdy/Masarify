-- Table
CREATE TABLE IF NOT EXISTS transactions (
    id INTEGER PRIMARY KEY,
    name TEXT,
    description TEXT,
    amount REAL,
    timestamp INTEGER,
    account_id INTEGER NOT NULL,
    type TEXT ,
    receiver_account_id INTEGER, -- Only for TRANSFER
    fee REAL, -- Only for TRANSFER
    remote_id INTEGER,
    sync_status TEXT NOT NULL DEFAULT 'PENDING'
);

-- Insert Queries
insertTransaction:
INSERT INTO transactions (type, name, description, amount, timestamp, account_id)
VALUES (:type, :name, :description, :amount, :timestamp, :account_id);

insertTransfer:
INSERT INTO transactions (type, name, description, amount, timestamp, account_id, receiver_account_id, fee)
VALUES ("TRANSFER", :name, :description, :amount, :timestamp, :account_id, :receiver_account_id, :fee);

insertTransactionCategory:
INSERT OR IGNORE INTO transaction_categories(transaction_id, category_id)
VALUES (:transaction_id, :category_id);

-- Update Query (consolidated)
updateTransaction:
UPDATE transactions
SET
    name = :name,
    description = :description,
    amount = :amount,
    timestamp = :timestamp,
    account_id = :account_id,
    type = :type
WHERE id = :id;

-- Delete Queries
deleteTransaction:
DELETE FROM transactions WHERE id = :id;

deleteTransactionCategory:
DELETE FROM transaction_categories WHERE transaction_id = :transaction_id;

getAllTransactionsOfType:
SELECT *
FROM v_transactions
WHERE transactionType = :type
ORDER BY transactionTimestamp DESC;

getAllTransactions:
SELECT *
FROM v_transactions
ORDER BY transactionTimestamp DESC;



getCategoriesForTransactionByTransactionId:
SELECT
    c.id,
    c.name,
    c.description,
    c.color,
    c.icon
FROM categories c
JOIN transaction_categories tc ON c.id = tc.category_id
WHERE tc.transaction_id = :transaction_id;


getTransactionById:
SELECT *
FROM v_transactions
WHERE transactionId = :id;


-- Aggregates
getMinTransactionOfType:
SELECT *
FROM v_transactions
WHERE transactionType = :type
ORDER BY transactionAmount ASC
LIMIT 1;

getMaxTransactionOfType:
SELECT *
FROM v_transactions
WHERE transactionType = :type
ORDER BY transactionAmount DESC
LIMIT 1;

getAverageTransactionValueOfType:
SELECT AVG(transactionAmount) AS averageAmount
FROM v_transactions
WHERE transactionType = :type;


selectLastInsertedRowId:
SELECT last_insert_rowid();

updateRemoteId:
UPDATE transactions SET remote_id = :remoteId, sync_status = 'SYNCED' WHERE id = :id;

getLocalIdByRemoteId:
SELECT id FROM transactions WHERE remote_id = :remoteId LIMIT 1;

getUnsyncedTransactionIds:
SELECT id FROM transactions WHERE remote_id IS NULL;

getTotalTransactionsOfTypeOfCurrency:
SELECT SUM(transactionAmount) AS total_amount
FROM v_transactions
WHERE transactionType = :type
  AND currencyId = :currencyId;

getTransactionsSumByCategoriesOfType:
SELECT
    c.id AS category_id,
    c.name AS category_name,
    c.description AS category_description,
    c.color AS category_color,
    c.icon AS category_icon,
    c.is_default AS is_default,
    c.resource_key AS resource_key,
    SUM(t.transactionAmount) AS total_amount
FROM v_transactions t
JOIN transaction_categories tc ON t.transactionId = tc.transaction_id
JOIN categories c ON tc.category_id = c.id
WHERE t.transactionType = :type
GROUP BY c.id;

-- Pagination queries
getAllTransactionsPaged:
SELECT *
FROM v_transactions
ORDER BY transactionTimestamp DESC
LIMIT :limit OFFSET :offset;

getAllTransactionsOfTypePaged:
SELECT *
FROM v_transactions
WHERE transactionType = :type
ORDER BY transactionTimestamp DESC
LIMIT :limit OFFSET :offset;

-- Count queries
getTransactionCount:
SELECT COUNT(*)
FROM v_transactions;

getTransactionCountOfType:
SELECT COUNT(*)
FROM v_transactions
WHERE transactionType = :type;

getExpenseCategoriesByUsage:
SELECT
    c.id AS category_id,
    c.name AS category_name,
    c.description AS category_description,
    c.color AS category_color,
    c.icon AS category_icon,
    c.is_default AS is_default,
    c.resource_key AS resource_key,
    COUNT(tc.transaction_id) AS usage_count
FROM categories c
LEFT JOIN transaction_categories tc ON c.id = tc.category_id
LEFT JOIN transactions t ON tc.transaction_id = t.id AND t.type = 'Expense'
WHERE c.id != 0 AND c.id != -2
GROUP BY c.id
ORDER BY usage_count DESC, c.id ASC
LIMIT :limit;
