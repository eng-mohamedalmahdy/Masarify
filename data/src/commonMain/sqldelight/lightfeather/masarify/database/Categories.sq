CREATE TABLE  IF NOT EXISTS  categories(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    color TEXT NOT NULL,
    icon TEXT NOT NULL,
    is_default INTEGER NOT NULL DEFAULT 0,
    resource_key TEXT,
    remote_id INTEGER,
    sync_status TEXT NOT NULL DEFAULT 'PENDING'
);

insertCategory:
INSERT INTO categories (name, description, color, icon, is_default, resource_key)
VALUES (:name, :description, :color, :icon, :is_default, :resource_key);

updateById:
UPDATE categories
SET name        = :name,
    description = :description,
    color       = :color,
    icon        = :icon,
    is_default  = :is_default,
    resource_key = :resource_key
WHERE id = :id;

deleteById:
DELETE FROM categories
WHERE id = :id;

selectAllCategories:
SELECT * FROM v_categories;

selectCategoryById:
SELECT * FROM v_categories
WHERE categoryId = :id;

selectLastInsertedRowId:
SELECT last_insert_rowid();

updateRemoteId:
UPDATE categories SET remote_id = :remoteId, sync_status = 'SYNCED' WHERE id = :id;

getLocalIdByRemoteId:
SELECT id FROM categories WHERE remote_id = :remoteId LIMIT 1;

getUnsyncedCategoryIds:
SELECT id FROM categories WHERE remote_id IS NULL AND is_default = 0;


