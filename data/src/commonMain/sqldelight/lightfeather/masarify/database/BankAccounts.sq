CREATE TABLE  IF NOT EXISTS  bank_accounts (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  currency INTEGER NOT NULL,
  name TEXT NOT NULL ,
  description TEXT,
  balance REAL NOT NULL DEFAULT  0.0,
  color TEXT NOT NULL,
  logo TEXT
);

insertBankAccount:
INSERT INTO bank_accounts (currency, name, description, balance, color, logo)
VALUES (:currency, :name, :description, :balance, :color, :logo);

updateAccount:
UPDATE bank_accounts
SET balance = :balance,
    name    = :name,
    color   = :color,
    logo    = :logo
WHERE id = :id;

deleteAccount:
DELETE FROM bank_accounts
WHERE id = :id;


getAllAccounts:
SELECT * FROM v_accounts;

getAccountById:
SELECT * FROM v_accounts
WHERE accountId = :id;


selectLastInsertedRowId:
SELECT last_insert_rowid();

